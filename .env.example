# Zuno — exemplo de configuração local.
# Copie para `.env` e ajuste. Nunca comite `.env` nem segredos reais.

# Interface de rede do servidor. 127.0.0.1 por padrão: não exponha a instância
# publicamente sem TLS, autenticação e revisão de segurança.
ZUNO_BIND_ADDR=127.0.0.1:8080

# Banco SQLite (criado automaticamente). Use caminho absoluto ou relativo ao CWD.
ZUNO_DATABASE_URL=sqlite://data/zuno.db

# Diretório da biblioteca musical (ainda não usado no M0; reservado para o M1).
ZUNO_MUSIC_DIR=./data/music

# Conexões máximas no pool SQLite (mantenha baixo em Raspberry Pi 3).
ZUNO_DB_MAX_CONNECTIONS=4

# Nível de log (trace, debug, info, warn, error).
RUST_LOG=info,zuno_server=debug

# URL base da API consumida pelo frontend em build de produção.
# Em desenvolvimento o Vite faz proxy de /health para 127.0.0.1:8080.
VITE_ZUNO_API_BASE_URL=

# Destino do proxy /health do Vite (apps/web/vite.config.ts). Ajuste se a porta
# 8080 já estiver ocupada por outro software:
# ZUNO_DEV_API_TARGET=http://127.0.0.1:18081
